# --- Database ---
# NOTE: docker-compose.yml overrides this with the in-network host "db".
# The value below is what a non-Docker local run (uvicorn directly) uses,
# so it matches the app's code defaults.
DATABASE_URL=postgresql://binduparakh:binduparakh@localhost:5432/binduparakh

# --- Auth ---
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRE_MINUTES=60

# --- Public registration ---
# Set to "false" on a public deployment to stop strangers from creating
# analyst accounts (default: true so local/demo setup stays frictionless).
ALLOW_REGISTRATION=true

# --- Default admin account (auto-created on first backend startup) ---
# Set your own real values here in your local, untracked .env file.
# Never commit real credentials -- this .env.example file is safe to
# publish because it contains no real secrets.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# --- Optional: shared read-only demo login (role "analyst"), safe to
# publish publicly alongside a live deployment link ---
GUEST_EMAIL=
GUEST_PASSWORD=

# --- Optional: your deployed frontend URL, for CORS on a public deployment ---
FRONTEND_URL=

# --- Detection rule thresholds (safe defaults, tune as needed) ---
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_WINDOW_MIN=5
IMPOSSIBLE_TRAVEL_MAX_KMH=900
MULTI_ACCOUNT_THRESHOLD=4
MULTI_ACCOUNT_WINDOW_MIN=10

# --- Optional: VPN/proxy detection (leave blank to disable this rule) ---
# Get a free key at https://www.ipqualityscore.com/
IPQUALITYSCORE_API_KEY=

# --- Optional: email alerts (leave blank to disable -- app still works) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_MIN_SEVERITY=high
